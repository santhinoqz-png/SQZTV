<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo claro estilo Apple: gris suave con destellos pastel sutiles -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FAFAFC"
                android:endColor="#E9EAF2" />
        </shape>
    </item>

    <!-- Destello azul suave arriba -->
    <item
        android:top="-220dp"
        android:left="420dp"
        android:bottom="560dp"
        android:right="-120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="520dp"
                android:startColor="#40D6E6FF"
                android:endColor="#00D6E6FF" />
        </shape>
    </item>

    <!-- Destello rosa suave abajo -->
    <item
        android:top="640dp"
        android:left="-220dp"
        android:bottom="-240dp"
        android:right="620dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="560dp"
                android:startColor="#40FCE3EF"
                android:endColor="#00FCE3EF" />
        </shape>
    </item>
</layer-list>
