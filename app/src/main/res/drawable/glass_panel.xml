<?xml version="1.0" encoding="utf-8"?>
<!-- Panel superior blanco translúcido estilo Apple claro -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <stroke android:width="1dp" android:color="#E0E0E5" />
            <solid android:color="#C8FFFFFF" />
        </shape>
    </item>
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="33dp" />
            <gradient
                android:angle="90"
                android:startColor="#33FFFFFF"

                android:endColor="#08FFFFFF" />
        </shape>
    </item>
</layer-list>
