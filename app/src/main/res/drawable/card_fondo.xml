<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta blanca con borde fino estilo Apple.
     Al enfocar con el control: borde azul Apple + sombra más alta -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="2dp" android:color="#0A84FF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#F0F0F5" />
            <stroke android:width="2dp" android:color="#0A84FF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#E3E3E8" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
